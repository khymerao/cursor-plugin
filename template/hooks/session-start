#!/usr/bin/env bash
# sessionStart — inject context at chat session start (Cursor: additional_context).
set -euo pipefail

escape_for_json() {
  local s="$1"
  s="${s//\\/\\\\}"
  s="${s//\"/\\\"}"
  s="${s//$'\n'/\\n}"
  s="${s//$'\r'/\\r}"
  s="${s//$'\t'/\\t}"
  printf '%s' "$s"
}

context="Plugin {{PLUGIN_DISPLAY_NAME}} is active. See skills/ and rules/ for agent guidance."

if [[ -n "${CURSOR_PLUGIN_ROOT:-}" ]]; then
  skill="$CURSOR_PLUGIN_ROOT/skills/{{PLUGIN_NAME}}-skill/SKILL.md"
  if [[ -f "$skill" ]]; then
    context="${context}\n\nPrimary skill: {{PLUGIN_NAME}}-skill"
  fi
fi

escaped=$(escape_for_json "$context")
printf '{\n  "additional_context": "%s"\n}\n' "$escaped"
exit 0
